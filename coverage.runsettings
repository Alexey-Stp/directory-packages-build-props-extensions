<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings shared by CI and local runs; see CONTRIBUTING.md. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- cobertura feeds reportgenerator in ci.yml; opencover feeds SonarQube Cloud in sonar.yml. -->
          <Format>cobertura,opencover</Format>
          <Exclude>[*.Tests]*,[CentralPackageMigrator.TestUtilities]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
